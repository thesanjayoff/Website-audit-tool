# Copy to .env.local and fill in what you have. Nothing here is required to run the tool.

# Chrome UX Report API key (field data / Core Web Vitals history). Get one from
# https://developer.chrome.com/docs/crux/api
CRUX_API_KEY=

# WebPageTest API key, only used if WEBPAGETEST_ENABLED=true
WEBPAGETEST_API_KEY=
WEBPAGETEST_ENABLED=false

# Optional AI layer for client-friendly rewrites of findings/executive summaries.
# Leave AI_PROVIDER unset or "local" to disable the AI layer entirely (default).
# Supported: "local" (disabled/no-op), "anthropic"
AI_PROVIDER=local
ANTHROPIC_API_KEY=

# Port/host the app binds to. Defaults to localhost-only.
HOST=127.0.0.1
PORT=3000

# Test-only SSRF allowlist (comma-separated exact hostnames). Leave unset.
# Exists solely so `npm test` can audit its own local fixture server
# (127.0.0.1) without weakening SSRF protection for real audits. Matches by
# exact hostname only — never set this in a real deployment.
SSRF_ALLOWLIST_HOSTS=
