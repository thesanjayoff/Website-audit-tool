{
  "name": "website-audit-tool",
  "version": "0.1.0",
  "private": true,
  "description": "Local, single-user website audit tool for agency use: performance, SEO, accessibility, security, and content checks with client-friendly reports.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed": "tsx src/server/db/seed.ts",
    "fixtures:serve": "tsx test/fixtures/server.ts",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "playwright": "1.65.1",
    "lighthouse": "13.6.0",
    "chrome-launcher": "1.2.3",
    "axe-core": "4.14.1",
    "pa11y": "10.0.0",
    "zod": "4.6.7",
    "node-cron": "4.6.0",
    "clsx": "2.1.1",
    "lucide-react": "1.74.0",
    "next-themes": "0.4.6",
    "recharts": "3.10.1",
    "dompurify": "3.4.18",
    "jsdom": "31.0.1",
    "nanoid": "6.0.2",
    "undici": "8.12.4",
    "ipaddr.js": "2.5.0",
    "robots-parser": "3.0.1",
    "fast-xml-parser": "5.12.1",
    "cheerio": "1.2.0",
    "mime-types": "3.0.2"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tailwindcss": "4.3.5",
    "@tailwindcss/postcss": "4.3.5",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "vitest": "5.1.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/pa11y": "5.3.7",
    "@types/node-cron": "3.0.11",
    "@types/mime-types": "3.0.1"
  }
}
